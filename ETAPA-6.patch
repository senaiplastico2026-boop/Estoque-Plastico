+
+/* Código da turma: um diálogo compartilhado pelas interfaces do professor. */
+.codigo-turma-botao {
+    border: 0;
+    border-radius: 4px;
+    padding: 2px 4px;
+    background: transparent;
+    color: #60a5fa;
+    font: inherit;
+    letter-spacing: inherit;
+    overflow-wrap: anywhere;
+    max-width: 100%;
+}
+
+.codigo-turma-botao:hover {
+    background: #172337;
+    text-decoration: underline;
+    text-underline-offset: 3px;
+}
+
+.codigo-turma-botao:focus-visible,
+.modal-codigo-turma__fechar:focus-visible {
+    outline: 2px solid #93c5fd;
+    outline-offset: 3px;
+}
+
+.turma-page-info > .codigo-turma-botao {
+    align-self: flex-start;
+    font-size: 12px;
+    font-weight: 700;
+}
+
+body.codigo-turma-modal-aberto {
+    overflow: hidden;
+}
+
+.modal-codigo-turma {
+    position: fixed;
+    inset: 0;
+    margin: auto;
+    padding: 0;
+    width: min(960px, calc(100vw - 32px));
+    max-width: calc(100vw - 32px);
+    max-height: calc(100dvh - 32px);
+    border: 1px solid #293746;
+    border-radius: 16px;
+    background: #141b23;
+    color: #e2e8f0;
+    box-shadow: 0 20px 50px rgba(0, 0, 0, .4);
+    overflow: auto;
+}
+
+.modal-codigo-turma::backdrop {
+    background: rgba(3, 7, 12, .82);
+}
+
+.modal-codigo-turma__conteudo {
+    position: relative;
+    padding: 64px clamp(12px, 4vw, 48px) 40px;
+    text-align: center;
+}
+
+.modal-codigo-turma__fechar {
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    width: 44px;
+    height: 44px;
+    border: 1px solid #344555;
+    border-radius: 8px;
+    background: #172337;
+    color: #e2e8f0;
+    font-size: 28px;
+}
+
+.modal-codigo-turma__fechar:hover {
+    background: #263e59;
+}
+
+.modal-codigo-turma h2 {
+    font-size: clamp(18px, 3vw, 26px);
+}
+
+.modal-codigo-turma__nome {
+    margin-top: 12px;
+    color: #94a3b8;
+    font-size: 18px;
+    overflow-wrap: anywhere;
+}
+
+.modal-codigo-turma__codigo {
+    margin: 24px 0;
+    color: #f1f5f9;
+    font-family: ui-monospace, Consolas, monospace;
+    font-size: clamp(36px, 11vw, 140px);
+    font-weight: 800;
+    font-variant-numeric: tabular-nums;
+    line-height: 1.15;
+    letter-spacing: .025em;
+    white-space: pre-wrap;
+    overflow-wrap: anywhere;
+}
+
+.modal-codigo-turma__instrucao {
+    color: #cbd5e1;
+    line-height: 1.6;
+    max-width: 48ch;
+    margin: auto;
+}
